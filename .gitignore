.godot/
*.import
!game/assets/rally/russia_stage1/russia_stage1_visual.glb.import
!game/assets/rally/russia_stage*/russia_stage*_visual.glb.import
!game/assets/rally/kenya_stage*/kenya_stage*_visual.glb.import
!game/assets/rally/finland_stage*/finland_stage*_visual.glb.import
!game/assets/rally/sweden_stage*/sweden_stage*_visual.glb.import
!game/assets/rally/switzerland_stage*/switzerland_stage*_visual.glb.import
!game/assets/rally/cdi_stage[1-4]/*.glb.import
!game/assets/rally/cdi_stage[1-4]/sectores/*.glb.import
!game/assets/weather/tropospheric/*.png.import
*.uid

# Texturas extraídas por Godot al importar collision GLBs con materiales
# (duplican las visuales; se regeneran solas en cada import).
game/assets/rally/*/*_collision_*.png

# Generated standalone runtime state and validation/export outputs.
.tools/appdata/
.tools/localappdata/
build/
dist/
rust/target/
scratch/
game/logs/
__pycache__/
*.pyc

# Fase 0 refactor: arboles locales que no deben trackearse.
tmp/
tmp_pacenote_review/
acl-recovery/
archive/
.uv-install*.log
_tmp_*

# Artefactos temporales de tuning/revisión (auto-generados, no versionar).
*.bak_pre_refine_all
game/data/tires/backups/rally_compounds_*.json

# Modelos pesados generados localmente (excluidos de Git remoto)
game/assets/rally/raura_stage2/*.glb
game/assets/rally/raurasr_stage2/*.glb
tools/rally/stage_gis/raura_quichas_gis/output/*.blend

# Temporary Godot SQLite debug library copy
/game/addons/godot-sqlite/bin/~libgdsqlite.windows.template_debug.x86_64.dll
