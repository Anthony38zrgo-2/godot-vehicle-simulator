asset_manifest_path = "res://assets/rally/rt/rt-alfa-giulia-gta/manifest.json"
rally_collision_path = "res://assets/rally/rt/rt-alfa-giulia-gta/collision.json"
cockpit_camera_enabled = false

[node name="Chassis" parent="." instance=ExtResource("chassis")]

[node name="VehicleVFX" type="Node3D" parent="."]
script = ExtResource("vfx")

[node name="WheelFrontLeft" type="Node3D" parent="."]

[node name="WheelVisual" type="Node3D" parent="WheelFrontLeft"]

[node name="WheelMesh" parent="WheelFrontLeft/WheelVisual" instance=ExtResource("front_left")]

[node name="WheelFrontRight" type="Node3D" parent="."]

[node name="WheelVisual" type="Node3D" parent="WheelFrontRight"]

[node name="WheelMesh" parent="WheelFrontRight/WheelVisual" instance=ExtResource("front_right")]

[node name="WheelRearLeft" type="Node3D" parent="."]

[node name="WheelVisual" type="Node3D" parent="WheelRearLeft"]

