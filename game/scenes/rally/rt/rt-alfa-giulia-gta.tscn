[ext_resource type="PackedScene" path="res://assets/rally/rt/rt-alfa-giulia-gta/wheel_rear_right.glb" id="rear_right"]

[sub_resource type="PhysicsMaterial" id="surface"]
friction = 0.35
bounce = 0.0

[node name="Vehicle" type="RigidBody3D"]
collision_layer = 2
collision_mask = 1
