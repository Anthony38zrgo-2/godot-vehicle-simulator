; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rust Godot Vehicle Simulator"
config/version="1.0"
run/main_scene="res://scenes/rally/rally_proving_ground.tscn"
config/features=PackedStringArray("4.7")

[autoload]

InputBindings="*res://scripts/input/input_bindings.gd"
VehicleAudioBus="*res://scripts/audio/ensure_vehicle_bus.gd"
RallyMusic="*res://scripts/audio/rally_music_manager.gd"
UIButtonAudio="*res://scripts/audio/ui_button_audio.gd"
RallyLoadingOverlay="*res://scripts/rally/rally_loading_overlay.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/TCA_Weather_System/plugin.cfg")

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=14
jolt_physics_3d/simulation/position_steps=4
jolt_physics_3d/simulation/penetration_slop=0.005
jolt_physics_3d/simulation/speculative_contact_distance=0.025
jolt_physics_3d/simulation/continuous_cd_movement_threshold=0.25
jolt_physics_3d/simulation/continuous_cd_max_penetration=0.1
jolt_physics_3d/queries/use_enhanced_internal_edge_removal=true

[audio]

driver/output_latency=40

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/use_debanding=false
textures/default_filters/anisotropic_filtering_level=0
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_size=512
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0

[filesystem]

import/blender/enabled=false

[shader_globals]

rally_sun_dir={
"type": "vec3",
"value": Vector3(0, 0.7, 0.7)
}
rally_sun_color={
"type": "vec3",
"value": Vector3(1, 0.95, 0.85)
}
rally_ambient_color={
"type": "vec3",
"value": Vector3(0.48, 0.54, 0.63)
}
rally_haze_color={
"type": "vec3",
"value": Vector3(0.68, 0.76, 0.86)
}
rally_wind_vec={
"type": "vec2",
"value": Vector2(1.2, 0.4)
}
rally_rain_intensity={
"type": "float",
"value": 0.0
}
rally_sky_horizon={
"type": "vec3",
"value": Vector3(0.45, 0.5, 0.56)
}
rally_sky_mix={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
rally_sky_tint_a={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
rally_sky_tint_b={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
rally_sky_tint_c={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
rally_sky_enabled={
"type": "float",
"value": 0.0
}
