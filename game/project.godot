; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rust Godot Vehicle Simulator"
config/version="1.0"
run/main_scene="res://scenes/rally/rally_proving_ground.tscn"
config/features=PackedStringArray("4.7")

[autoload]

InputBindings="*res://scripts/input/input_bindings.gd"
VehicleAudioBus="*res://scripts/audio/ensure_vehicle_bus.gd"
RallyMusic="*res://scripts/audio/rally_music_manager.gd"
UIButtonAudio="*res://scripts/audio/ui_button_audio.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/TCA_Weather_System/plugin.cfg")

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[audio]

driver/output_latency=40

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/use_debanding=false
textures/default_filters/anisotropic_filtering_level=0
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_size=512
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0

[filesystem]

import/blender/enabled=false
